{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  // No custom domain yet; served from api.<subdomain>.workers.dev.
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a2n-dev",
      "database_id": "194d7ef7-6d41-4e40-9582-1a3748174a84",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "a2n-dev",
      // Clients upload straight to the real bucket with presigned URLs, so local dev reads it too.
      "remote": true
    }
  ],
  "workflows": [
    {
      "name": "process-source",
      "binding": "PROCESS_SOURCE",
      "class_name": "ProcessSource"
    }
  ],
  // yt-dlp + ffmpeg for YouTube (apps/processor). Needs Docker running for `wrangler dev` and deploys.
  "containers": [
    {
      "class_name": "Processor",
      "image": "../processor/Dockerfile",
      "instance_type": "basic",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PROCESSOR", "class_name": "Processor" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Processor"] }],
  // Per-minute limits (lib/ratelimit.ts). Counted per Cloudflare location, so they stop floods and
  // scripts, not a determined attacker; namespace ids only need to be unique in the account.
  "ratelimits": [
    // Sign-in POSTs per IP (a campus NAT can share one IP, so it's generous)
    { "name": "RL_AUTH_IP", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Sign-in codes sent to one email address
    { "name": "RL_OTP_EMAIL", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // Per user
    { "name": "RL_SOURCES", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_UPLOADS", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_CHAT", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } }
  ],
  // Morning reminder emails at 07:30 IST (lib/notify.ts REMINDER_CRON).
  "triggers": { "crons": ["0 2 * * *"] },
  // Non-secret config. Secrets (API keys, auth secret, R2 S3 keys) live in
  // .dev.vars locally and `wrangler secret put` when deployed.
  "vars": {
    "WEB_ORIGIN": "http://localhost:3000",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "R2_ACCOUNT_ID": "bd57f70b4e6b19220cb3f9972bb6ba8d",
    "R2_BUCKET_NAME": "a2n-dev",
    "LLM_BASE_URL": "https://openrouter.ai/api/v1",
    "MODEL_NOTES": "xiaomi/mimo-v2.6-flash",
    "MODEL_LIGHT": "xiaomi/mimo-v2.6-flash",
    "MODEL_CHAT": "xiaomi/mimo-v2.6-flash",
    "MODEL_VISION": "xiaomi/mimo-v2.6-flash",
    "MODEL_FALLBACK": "xiaomi/mimo-v2.6-flash",
    "STT_BASE_URL": "https://api.groq.com/openai/v1",
    "STT_MODEL": "whisper-large-v3-turbo",
    // Temporary sender domain until anything2note.com is bought and verified in Resend.
    "EMAIL_FROM": "anything2note <noreply@anuragmaurya.com>"
  }
}
