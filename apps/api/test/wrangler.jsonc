{
  // Test-only Worker config (vitest.config.ts). Same Worker as ../wrangler.jsonc, minus what the
  // Workers test runtime can't host or shouldn't reach: no Processor container (it needs Docker
  // and isn't used by the routes under test), a local R2 bucket instead of the remote one, and
  // dummy secrets so nothing talks to real services. Lives in test/ so ../.dev.vars isn't loaded.
  "name": "api-test",
  "main": "../src/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "a2n-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../drizzle" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "a2n-test" }],
  "workflows": [{ "name": "process-source", "binding": "PROCESS_SOURCE", "class_name": "ProcessSource" }],
  "ratelimits": [
    { "name": "RL_AUTH_IP", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_OTP_EMAIL", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_SOURCES", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_UPLOADS", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_CHAT", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "WEB_ORIGIN": "http://localhost:3000",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "BETTER_AUTH_SECRET": "test-secret-test-secret-test-secret-0123456789",
    "R2_ACCOUNT_ID": "test",
    "R2_BUCKET_NAME": "a2n-test",
    "R2_ACCESS_KEY_ID": "test",
    "R2_SECRET_ACCESS_KEY": "test",
    "LLM_BASE_URL": "http://127.0.0.1:9/llm",
    "LLM_API_KEY": "test",
    "MODEL_NOTES": "test",
    "MODEL_LIGHT": "test",
    "MODEL_CHAT": "test",
    "MODEL_VISION": "test",
    "MODEL_FALLBACK": "test",
    "STT_BASE_URL": "http://127.0.0.1:9/stt",
    "STT_API_KEY": "test",
    "STT_MODEL": "test",
    "EMAIL_FROM": "test <test@example.test>",
    "RESEND_API_KEY": "test",
    "GOOGLE_CLIENT_ID": "test",
    "GOOGLE_CLIENT_SECRET": "test",
    "NODE_ENV": "test",
    "DODO_PAYMENTS_TEST_API_KEY": "test",
    "DODO_PAYMENTS_TEST_WEBHOOK_KEY": "dGVzdA==",
    "DODO_PAYMENTS_LIVE_API_KEY": "test",
    "DODO_PAYMENTS_LIVE_WEBHOOK_KEY": "dGVzdA==",
    "YOUTUBE_API_KEY": "test"
  }
}
