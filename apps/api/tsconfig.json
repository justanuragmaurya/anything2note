{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  // Tests have their own tsconfig (test/tsconfig.json) with the Workers test types.
  "exclude": ["node_modules", "test", "vitest.config.ts"]
}
