# Base URL of apps/api (Better Auth lives under /api/auth/*).
# iOS Simulator / Android emulator on this Mac: http://localhost:8787
# Physical phone: use the Mac's LAN IP (e.g. http://192.168.0.9:8787) and start the API with `--ip 0.0.0.0`.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Origin of apps/web: "Manage plan on the web" opens <this>/app/billing. Same host rules as above
# (port 3000). Falls back to https://anything2note.com when unset.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
